# .env로 복사해서 값을 채웁니다. .env는 git에 올라가지 않습니다.
# 로컬에서 Postgres(docker)를 쓰려면 아래 주석을 풉니다. 비워 두면 메모리 DB(H2)로 뜹니다.
# DB_URL=jdbc:postgresql://localhost:5432/memorial
# DB_USER=memorial
# DB_PASSWORD=memorial

# --- 여기부터는 배포 서버(Oracle VM)에서만 채웁니다. docs/deploy.md 참고 ---
# 장기 앱 caddy 뒤에 붙습니다.
# COMPOSE_FILE=docker-compose.yml:deploy/compose.janggi.yml
# Cloudflare Pages 웹 주소.
# MEMORIAL_CORS_ALLOWED_ORIGINS=https://<프로젝트이름>.pages.dev
# DB 비밀번호. 처음 띄우기 전에 정해야 합니다(나중에 바꾸면 DB에 반영되지 않습니다).
# POSTGRES_PASSWORD=
# 한 IP가 1분에 쓸 수 있는 글·공감·헌화 수.
# MEMORIAL_WRITES_PER_MINUTE=30
# JAVA_TOOL_OPTIONS=-Xmx256m
